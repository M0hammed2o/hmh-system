# HMH Backend — environment variables
# Copy this file to .env and fill in real values before running.
# NEVER commit your real .env file to git.

# ── Application ──────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=change_this_to_a_random_64_char_string_before_production

# ── Database ─────────────────────────────────────────────────
# These vars are read by docker-compose.yml to create the container.
# They must match the credentials in DATABASE_URL below.
POSTGRES_USER=hmh
POSTGRES_PASSWORD=hmhdev
POSTGRES_DB=hmh_system

# Connection string for the FastAPI backend
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# ── JWT ──────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File Storage ─────────────────────────────────────────────
# Local disk is a development/test convenience only. Outside development/test,
# SUPABASE_URL + SUPABASE_SERVICE_KEY are REQUIRED (startup fails otherwise) —
# see app/core/config.py validate_production_storage.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ── Supabase Storage ─────────────────────────────────────────
# service_role key — never the anon key. Two buckets are used:
#   hmh-uploads (public: true)  — legacy uploads (delivery notes/signatures,
#     stock usage evidence, milestone stage photos, generated MR/PO PDFs)
#   SUPABASE_PRIVATE_BUCKET (public: FALSE) — Fuel evidence and generic
#     attachments; served only via short-lived signed URLs through
#     GET /attachments/{id}/download
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PRIVATE_BUCKET=hmh-evidence-private
EVIDENCE_SIGNED_URL_EXPIRY_SECONDS=300

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Required outside development/test. Use the public HTTPS origin only (no path/query/fragment).
FRONTEND_BASE_URL=http://localhost:5173

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── WhatsApp Cloud API ───────────────────────────────────────
# Get these from Meta Business Manager → WhatsApp → API Setup
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=hmh_verify_token
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEST_TO=

# Alert escalation
CRITICAL_ALERT_MAX_ATTEMPTS=5
HIGH_ALERT_MAX_ATTEMPTS=2
HIGH_ALERT_FIRST_REMINDER_MINUTES=15

# ── SMTP / Email (Gmail) ─────────────────────────────────────
# When Gmail is ready: set SMTP_ENABLED=true and fill in the three credentials.
# Use a Gmail App Password (not your account password).
# Generate at: myaccount.google.com/apppasswords
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HMH Procurement

# Optional: CC and BCC all procurement emails (comma-separated addresses)
PROCUREMENT_EMAIL_CC=
PROCUREMENT_EMAIL_BCC=

# ── IMAP / Gmail Inbox Reader ────────────────────────────────
# When Gmail is ready: set IMAP_ENABLED=true.
# Use the same Gmail address and app password as SMTP above.
# The reader fetches unread procurement emails and saves attachments locally.
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=procurementhmhgroup@gmail.com
IMAP_PASSWORD=
